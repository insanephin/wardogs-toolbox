{
  // Server code runs as-is through Node's type stripping, so only erasable syntax is allowed
  // (no enums, namespaces or constructor parameter properties).
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["server", "web/vite.config.ts"]
}
